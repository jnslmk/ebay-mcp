# eBay Developer keyset (https://developer.ebay.com/my/keys)
#
# Production credentials use a "PRD" prefix, sandbox uses "SBX". The two keysets
# are separate — do not mix a sandbox CLIENT_ID with a production CLIENT_SECRET.
EBAY_CLIENT_ID=your_app_id_here
EBAY_CLIENT_SECRET=your_cert_id_here

# Marketplace: EBAY_DE (ebay.de), EBAY_US, EBAY_GB, EBAY_FR, EBAY_IT, EBAY_ES, ...
EBAY_MARKETPLACE=EBAY_DE

# Environment: "sandbox" or "production".
# Sandbox has almost no real inventory — use it to verify the integration, then
# switch to "production" once the production keyset is OAuth-enabled.
EBAY_ENV=sandbox

# Upper bound (seconds) on retry sleeps, including a server-sent Retry-After.
# EBAY_RETRY_CAP=8

# Transport: "http" (default, streamable-HTTP on :8000/mcp) or "stdio".
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp
